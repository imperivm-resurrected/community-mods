<class id="HPriest" cpp_class="CVXDruid" parent="BaseMage" entity="Units/HPriest/HPriest.ent.xml">

	<properties race="ImperialRome"/>
	<properties maxhealth="140"/>
	<properties armor_slash="10" armor_pierce="10"/>
	<properties speed="50"/>
	<properties unit_specials="Determination, Keen sight"/>
	<properties range="300" sight="400"/>

	<properties icon="gameres/icons/HPriest.bmp"/>
	<properties display_name="Priest" display_name_plural="Priests"/>
	<properties help="contents/units/HPriest"/>
	<properties edittree_pos="Units/Grecia/Sacerdote"/>
	<sounds command="data/sound entities/VoiceHPriest.xml"/>
	<behavior script="data/subai/keensight_observe.vs"/>
	
	<method sig="stand_position"  vs="data/subai/hdruid_stand_position.vs"/>
	<method sig="ondie"           vs="data/subai/druid_ondie.vs"/>
	<method sig="advance"         vs="data/subai/hdruid_advance.vs"/>
	<method sig="idle"            vs="data/subai/hdruid_idle.vs"/>
	<!-- script missing in Secuter's zip: <method sig="centaur_summoning" vs="data/subai/centaur_summoning.vs"/> -->
	
	<method sig="buff_balanced" vs="data/subai/druid_buff_balanced_call.vs"/>

	<method sig="learn"           vs="data/subai/druid_learn.vs"/>
	<method sig="revitalize"      vs="data/subai/druid_revitalize.vs" verify="data/subai/druid_revitalize_verify.vs"/>
	<method sig="revitalize"      vs="data/subai/druid_revitalize_ground.vs"/>
	<method sig="coverofmercy"   vs="data/subai/enchantress_coverofmercy.vs"/>
	<!--<method sig="h_restoration"      vs="data/subai/druid_restoration.vs"/> -->
	
	<defaultcmd target="Unit">
    <cmd name="revitalize"/>
    </defaultcmd>

	<defaultcmd target="Hero">
		<cmd name="attach"/>
	</defaultcmd>

	<defaultcmd target="ShipBattle">
		<cmd name="boardship"/>
		<cmd name="approach"/>
	</defaultcmd>

</class>
