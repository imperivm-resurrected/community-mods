	<method sig="wolf_summoning"    vs="data/subai/druid_wolf_summoning.vs"/>
	<method sig="b_mass_heal"       vs="data/subai/druid_massheal.vs"/>
	
	<method sig="coverofmercy"   vs="data/subai/druid_coverofmercy.vs"/>
	<method sig="buff_speed" vs="data/subai/druid_buff_speed_call.vs"/>

	<defaultcmd target="Unit">
		<cmd name="hide"/>
	</defaultcmd>

	<defaultcmd target="Hero">
		<cmd name="attach"/>
	</defaultcmd>

	<defaultcmd target="ShipBattle">
		<cmd name="boardship"/>
		<cmd name="approach"/>
	</defaultcmd>

</class>
