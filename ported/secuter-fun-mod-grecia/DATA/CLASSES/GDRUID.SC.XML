<class id="GDruid" cpp_class="CVXDruid" parent="BaseMage" entity="Units/GDruid/GDruid.ent.xml">

	<properties race="Gaul"/>
	<properties maxhealth="120"/>
	<properties armor_slash="2" armor_pierce="2"/>
	<properties speed="50"/>
	<!-- Invisibility aggiunto (Imperivm 2): druid_hide_unit.vs richiede
	     HasSpecial(invisibility). L'abilita' vera e propria (ghide) e' comunque
	     visibile solo in Imperivm 2 (GDRUID_IMPERIVM2_GATE.VS) e sbloccata dalla
	     ricerca "Invisibility" della Casa dei Druidi. -->
	<properties unit_specials="Healing, Sneak, Invisibility"/>

	<properties icon="gameres/icons/GDruid.bmp"/>
	<properties display_name="Druid" display_name_plural="Druids"/>
	<properties help="contents/units/GDruid"/>
	<properties edittree_pos="Units/Gallia/Druido"/>
	<sounds command="Sounds/entities/VoiceGDruid.xml"/>

	<method sig="stand_position"  vs="data/subai/rpriest_stand_position.vs"/>
	<method sig="ondie"           vs="data/subai/druid_ondie.vs"/>
	<method sig="advance"         vs="data/subai/rpriest_advance.vs"/>
	<method sig="idle"            vs="data/subai/rpriest_idle.vs"/>
	<method sig="glearn"          vs="data/subai/druid_learn.vs"/>

	<method sig="heal"            vs="data/subai/druid_heal.vs" verify="data/subai/druid_heal_verify.vs"/>
	<method sig="heal"            vs="data/subai/druid_heal_ground.vs"/>
	<method sig="ghoul_summoning" vs="data/subai/druid_ghoul_summoning.vs"/>
	<method sig="eagle_summoning" vs="data/subai/druid_eagle_summoning.vs"/>
	<!--method sig="restoration"     vs="data/subai/druid_restoration.vs"/-->
	
	<method sig="wrath_of_belenos" vs="data/subai/priest_jupiter_anger.vs"/>
	<method sig="buff_attack" vs="data/subai/druid_buff_attack_call.vs"/>
	<!-- Invisibilita' (Imperivm 2): stessi vs di BDruid; l'abilita' e' esposta via
	     il comando "ghide" (DRUID.XML), gestito da GDRUID_IMPERIVM2_GATE.VS. -->
	<method sig="hide"            vs="data/subai/druid_hide_unit.vs"/>
	<method sig="hide"            vs="data/subai/druid_hide_ground.vs"/>
	<!-- Guarigione di massa (Imperivm 2): il druido si sacrifica; l'effetto e' in
	     druid_ondie.vs (ramo Gallia). Esposta dal comando "g_mass_heal" (DRUID.XML). -->
	<method sig="mass_heal"       vs="data/subai/druid_massheal.vs"/>

	<defaultcmd target="Unit">
		<cmd name="heal"/>
	</defaultcmd>

	<defaultcmd target="Hero">
		<cmd name="attach"/>
	</defaultcmd>

	<defaultcmd target="ShipBattle">
		<cmd name="boardship"/>
		<cmd name="approach"/>
	</defaultcmd>

	<behavior script="data/subai/sneak_behavior.vs"/>
	<behavior script="data/subai/gdruid_varios_gate.vs"/>
	<behavior script="data/subai/gdruid_imperivm2_gate.vs"/>

</class>
