<!-- Teuton Master: i tre teutoni si scambiano tra loro in ogni direzione. Ogni
     coppia ha il suo comando ("convert", "convert_wolf", "convert_aw") perche'
     la classe di arrivo si ricava da quella di partenza. Tasti: x = prima
     alternativa, z = seconda. -->
<cmd name="to_teuton_rider" priority="13"
	button="actions/ToRider.bmp"
	key="x"
	voidgroupdispatch="1"
	groupverifier="data/subai/teuton_archer_mutate_gv.vs"
	groupdispatch="data/subai/teuton_mutate_gd.vs"
	rollover="Convert to Teuton Rider"
	param="Requires Teuton Master research from Sanctuary of Votan">
	<src obj="TTeutonArcher"/>
</cmd>

<cmd name="to_teuton_wolf_from_archer" priority="14"
	button="actions/ToWolf.bmp"
	key="z"
	voidgroupdispatch="1"
	groupverifier="data/subai/teuton_archer_mutate_gv.vs"
	groupdispatch="data/subai/teuton_aw_mutate_gd.vs"
	rollover="Convert to Teuton Raider"
	param="Requires Teuton Master research from Sanctuary of Votan">
	<src obj="TTeutonArcher"/>
</cmd>

<cmd name="to_teuton_archer" priority="13"
	button="actions/ToArcher.bmp"
	key="x"
	voidgroupdispatch="1"
	groupverifier="data/subai/teuton_rider_mutate_gv.vs"
	groupdispatch="data/subai/teuton_mutate_gd.vs"
	rollover="Convert to Teuton Archer"
	param="Requires Teuton Master research from Sanctuary of Votan">
	<src obj="TTeutonRider"/>
</cmd>

<cmd name="to_teuton_wolf" priority="14"
	button="actions/ToWolf.bmp"
	key="z"
	voidgroupdispatch="1"
	groupverifier="data/subai/teuton_rider_mutate_gv.vs"
	groupdispatch="data/subai/teuton_wolf_mutate_gd.vs"
	rollover="Convert to Teuton Raider"
	param="Requires Teuton Master research from Sanctuary of Votan">
	<src obj="TTeutonRider"/>
</cmd>

<cmd name="to_teuton_rider_from_wolf" priority="13"
	button="actions/ToRider.bmp"
	key="x"
	voidgroupdispatch="1"
	groupverifier="data/subai/teuton_wolf_mutate_gv.vs"
	groupdispatch="data/subai/teuton_wolf_mutate_gd.vs"
	rollover="Convert to Teuton Rider"
	param="Requires Teuton Master research from Sanctuary of Votan">
	<src obj="TTeutonWolf"/>
</cmd>

<cmd name="to_teuton_archer_from_wolf" priority="14"
	button="actions/ToArcher.bmp"
	key="z"
	voidgroupdispatch="1"
	groupverifier="data/subai/teuton_wolf_mutate_gv.vs"
	groupdispatch="data/subai/teuton_aw_mutate_gd.vs"
	rollover="Convert to Teuton Archer"
	param="Requires Teuton Master research from Sanctuary of Votan">
	<src obj="TTeutonWolf"/>
</cmd>

<!-- Il <src> e' commentato (comando disattivato), ma il groupverifier puntava a
     data/subai/gtridentwarrior_teach_verify.vs, che NON esiste: il motore lo
     segnalava a ogni avvio con "Group verifier not found". Rimosso l'attributo:
     il comando resta inerte, ma vxlog.log torna pulito. Per riattivare la
     funzione servono sia lo script verifier sia il <src>. -->
<cmd name="trident_warrior_teach" priority="13"
	button="actions/Trident Teach.bmp"
	key="h"
	rollover="Teach an ally"
	description="Teach an allied warrior, granting it 1 level (the Trident Warrior loses 1 level)"
	param="Requires Trident Warrior Experience III research from the Arena"
	>
	<cmdtext target="Unit"
		text="Click to teach ally"
		default-text="Right-click to teach ally"/>
	<cmdtext target=""
		text=""
		default-text=""/>
	<!-- rimosso dal Guerriero di Fand: <src obj="GTridentWarrior"/> -->
</cmd>

