<!-- Berserker: reclutamento a cap HARD (come Achemenidi/Mountaineer) via -->
<!-- method="trainex". Il limite (MaxNVAEL) conta anche la coda (QueuedBuild) -->
<!-- in trainex_onaddremove.vs, quindi non si puo' sforare accodando. -->
<!-- param: numbertotrain, numparam, classe, gruppo, research, researchedfrom. -->
<!-- Ramo "berserker" -> MaxNVAEL in verify_trainex/barrack_train_ex/onaddremove. -->
<cmd name="trainNVael" priority="11"
	button="actions/Berserker.bmp"
	queueicon="gameres/icons/BERSERKER.bmp"
	groupverifier="data/subai/verify_trainex.vs"
	onaddremovescript="data/subai/trainex_onaddremove.vs"
	transpicon="1"
	traincommand="yes"
	key="b"
	costgold = "250"
	costfood = "0"
	costpop = "1"
	execdelay = "20000"
	rollover="Call Berserker"
	description="Summons a Berserker: Rage, Life steal and Sneak"
	method="trainex"
	param="1, berserker, NVAEL, Berserkers, Berserker Horde I, Temple of Thor">
	<src obj="BTempleOfThor"/>
</cmd>

