<commands>

<!-- TOWNHALL COMMANDS -->

<cmd name="repair townhall" priority="1"
	method="repair"
	button="actions/repair.bmp"
	key="r"
	queueicon="gameres/icons/upgrades/repair.bmp"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	rollover="Repair"
	costgold = "100"
	costfood = "0"
	execdelay = "60000">
	<src obj="BaseTownhall"/>
</cmd>

<cmd name="unitsout" priority="9"
	traincommand="no"
	key="o"
	groupdispatch="data/subai/group_unitsout.vs"
>
	<cmdtext target=""
		text=""/>
</cmd>

<cmd name="autotrain_start_gr" priority="9"
	immediate="yes"
	key="a"
	method="autotrain_start"
	groupverifier="data/subai/autotrain_start_verify.vs"
	button="actions/autotrainingStart.bmp"
	description="Start automatic training of warriors in the stronghold"
	rollover="Automatic training">
	<src obj="GTownhall"/>
	<src obj="RTownhall"/>
	<src obj="MTownhall"/>
	<src obj="HTownhall"/>
</cmd>

<cmd name="autotrain_stop_gr" priority="9"
	immediate="yes"
	key="a"
	method="autotrain_stop"
	groupverifier="data/subai/autotrain_stop_verify.vs"
	button="actions/autotrainingStop.bmp"
	description="Stop automatic training of warriors in the stronghold"
	rollover="Stop automatic training">
	<src obj="GTownhall"/>
	<src obj="RTownhall"/>
	<src obj="MTownhall"/>
	<src obj="HTownhall"/>
</cmd>

<!-- Automatic training RIMOSSO da Cartagine (C), Britannia (B), Egitto (E) e
     Germania (T) su richiesta (rev.7): i comandi autotrain_start_cbet /
     autotrain_stop_cbet erano gli unici che davano l'addestramento automatico
     a queste 4 fazioni (src CTownhall/BTownhall/ETownhall/TTownhall) e sono
     stati eliminati. Restano solo su Grecia/Rome (_gr), Iberia (_i) e l'IA
     (autotrain_start/stop su BaseTownhall). -->


<cmd name="autotrain_start_i" priority="9"
	immediate="yes"
	key="a"
	method="autotrain_start"
	groupverifier="data/subai/autotrain_start_verify.vs"
	button="actions/autotrainingStart.bmp"
	description="Start automatic teaching of warriors in the stronghold"
	rollover="Automatic teaching">
	<src obj="ITownhall"/>
</cmd>

<cmd name="autotrain_stop_i" priority="9"
	immediate="yes"
	key="a"
	method="autotrain_stop"
	groupverifier="data/subai/autotrain_stop_verify.vs"
	button="actions/autotrainingStop.bmp"
	description="Stop automatic teaching of warriors in the stronghold"
	rollover="Stop automatic teaching">
	<src obj="ITownhall"/>
</cmd>

<cmd name="refreshment" priority="10"
	immediate="yes"
	key="r"
	costgold = "500"
	costfood="0"
	method="refreshment"
	researchcommand="yes"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	button="actions/refreshment.bmp"
	rollover="Refreshment"
	description = "Restores the stamina of all friendly warriors around the townhall"
	>
	<src obj="BTownhall"/>
</cmd>

<!-- "Tribal Unification" si sblocca nel colosseo (BMorrigansMonument), non nel
     foro: vedi COMMANDS/ARENA.XML. Gli Highlander compaiono comunque nel foro,
     perche' ONFINISH_RESEARCH.VS li aggiunge con settlement.ForceAddUnit. -->

<cmd name="healing" priority="10"
	immediate="yes"
	key="h"
	costgold = "1000"
	costfood="0"
	method="healing"
	researchcommand="yes"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	button="actions/healing.bmp"
	rollover="Healing"
	description = "Restores 2000 health between the friendly warriors around the townhall"
	>
	<src obj="ITownhall"/>
	<src obj="HTownhall"/>
</cmd>

<!-- AI only -->
<cmd name="autotrain_start" priority="8"
	immediate="yes"
	method="autotrain_start">
	<src obj="BaseTownhall"/>
</cmd>

<!-- AI only -->
<cmd name="autotrain_stop" priority="8"
	immediate="yes"
	method="autotrain_stop">
	<src obj="BaseTownhall"/>
</cmd>

<cmd name="townhall_military_training" priority="10"
	method="military_training"
	key="m"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	costgold="500"
	costfood="0"
	button="actions/Military training.bmp"
	rollover="Military training"
	description="Adds 1 level to all allies around the townhall (up to level 10)"
	immediate="yes"
	researchcommand="yes"
>
	<src obj="GTownhall"/>
	<src obj="RTownhall"/>
	<src obj="MTownhall"/>
	<src obj="CTownhall"/>
</cmd>

<!-- Germania: stesso addestramento, ma pagato in viveri invece che in oro. E' un
     comando a parte perche' il costo sta sull'attributo del comando, quindi non si
     puo' differenziare per singolo <src>. TTownhall e' stato tolto dal comando in
     oro qui sopra, cosi' i Germani vedono solo questo. -->
<cmd name="townhall_military_training_german" priority="10"
	method="military_training"
	key="m"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	costgold="0"
	costfood="500"
	button="actions/MILITARY TRAINING FOOD.bmp"
	rollover="Military training"
	description="Adds 1 level to all allies around the townhall (up to level 10). Costs food"
	immediate="yes"
	researchcommand="yes"
>
	<src obj="TTownhall"/>
</cmd>

<cmd name="townhall_imperial_training" priority="10"
	method="imperial_training"
	key="i"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	costgold="800"
	costfood="0"
	button="actions/Imperial training.bmp"
	rollover="Imperial training"
	description="Adds 1 level to all your units around the townhall (up to level 16)"
	immediate="yes"
	researchcommand="yes"
>
	<src obj="RTownhall"/>
</cmd>

<!-- ========== IMPERIVM 2 COST VARIANTS (mode-only) ========== -->
<cmd name="townhall_military_training Imp2 Cost" priority="10"
	method="military_training"
	key="m"
	groupverifier="data/subai/verify_cmdcost_building.vs"
	param="ReqModeImp2, , ,"
	costgold="1200"
	costfood="0"
	button="actions/Military training.bmp"
	rollover="Military training"
	description="Adds 1 level to all allies around the townhall (up to level 10)"
	immediate="yes"
	researchcommand="yes"
>
	<src obj="RTownhall"/>
	<src obj="MTownhall"/>
	<src obj="CTownhall"/>
</cmd>
</commands>
