<!-- Mulo di rifornimento: comando disponibile a OGNI eroe (tutte le civilta',
     nessun upgrade, nessun costo oltre ai 1000 viveri). Prende 1000 viveri
     dall'edificio del giocatore piu' vicino e manda un mulo (1000 cibo) a
     seguire l'eroe. Il mulo non e' equipaggiabile: si muove col tasto destro.
     Vedi HERO_SUPPLY_MULE.VS. -->
<cmd name="hero_supply_mule" priority="45"
	button="actions/Create Mule Food.bmp"
	queueicon="gameres/icons/wagon.bmp"
	key="m"
	rollover="Supply Mule"
	description="Takes 1000 food from your nearest building and sends a mule to follow the hero"
	immediate="yes"
	method="hero_supply_mule"
	groupverifier="data/subai/hero_supply_mule_verify.vs">
	<src obj="Hero"/>
	<nsrc obj="HeroShip"/>
</cmd>

<!-- Seleziona unita' con Liberta': comando di OGNI eroe (tutte le civilta',
     nessun costo, sempre disponibile). Seleziona d'un colpo, sull'intera mappa,
     SOLO le unita' del giocatore che hanno l'abilita' "Freedom" (Liberta') -
     non il resto delle unita'. Vedi HERO_SELECT_ARMY.VS. Icona placeholder
     (states/Column.bmp), sostituibile con una dedicata. -->
<cmd name="hero_select_army" priority="46"
	button="upgrades/OLIGARCHY.BMP"
	key="a"
	rollover="Select Freedom units"
	description="Selects all your units that have the Freedom ability, across the entire map"
	immediate="yes"
	method="hero_select_army"
	groupverifier="">
	<src obj="Hero"/>
	<nsrc obj="HeroShip"/>
</cmd>
<!-- NB icona "Select Freedom units": button base = UI/CMDBAR/ -> UI/CMDBAR/UPGRADES/OLIGARCHY.BMP (icona esistente mai usata, scelta al posto del placeholder) -->

