<!-- Fleet Skills - FUNZIONE NON IMPLEMENTATA.
     Questi 3 comandi sono inerti: la classe "HeroShip" del <src> non esiste in
     nessun file (ne' in DATA/CLASSES ne' dentro Packs/data.pak), non esiste un
     metodo "heroship_skill" su nessuna classe, e il groupverifier puntava a
     data/subai/verify_heroship_skill.vs, anch'esso inesistente (3 righe
     "Group verifier not found" a ogni avvio). L'attributo groupverifier e'
     stato rimosso per ripulire vxlog.log; le definizioni restano qui come
     traccia. Per implementarla servono: classe HeroShip, metodo
     heroship_skill e lo script verifier (modello: VERIFY_HERO_SKILL.VS). -->
<cmd name="heroship_skill_breach" priority="51"
	button="skills/Breach.bmp"
	key="r"
	rollover="Breach"
	method="heroship_skill"
	description="Quadruples the damage of all attached Ram Ships as long as they have stamina, but drains their stamina by 1 point every second (skill lasts for a maximum of 10 seconds)"
	coststamina="6"
	immediate="yes"
	param="Breach">
	<src obj="HeroShip"/>
</cmd>

<cmd name="heroship_skill_inspiration" priority="52"
	button="skills/Inspiration.bmp"
	key="i"
	rollover="Inspiration"
	method="heroship_skill"
	description="For 10 seconds, renders the Flagship nearly invincible, drawing the attacks of up to 5 enemy ships within sight, then, increases the level of all other attached ships by 1 for every distracted enemy ship"
	coststamina="8"
	immediate="yes"
	param="Inspiration">
	<src obj="HeroShip"/>
</cmd>

<cmd name="heroship_skill_mending" priority="53"
	button="skills/Mending.bmp"
	key="n"
	rollover="Mending"
