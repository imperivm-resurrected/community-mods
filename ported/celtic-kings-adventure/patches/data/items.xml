<!-- Two items of HD that the Celtic Kings Adventure changes, as items of its own (the adventure's scripts ask for "CK Glowing gem" and "CK Gem of Power"): HD's keep their id and behavior. The name is the id too (the adventure saves what a hero carries by name and gives it back with AddItem); loc/*.loc.xml translate it -->
<patch>
  <add select="/items">
	<item id="CK Glowing gem"
	      image="gameres/icons/items/Red Diamond.bmp"
	      sound="data/sound entities/ItemUse.xml"
	      level="0"
	      usecount="0"
	      name="CK Glowing gem"
	      description="The gem now can channel the Power of the Goddess"
	      use_script="file://data/ItemScripts/ck glowing gem.vs"
	      cursed="1"
	      important="yes">
	  <bonus health="0" damage="0" armor_slash="0" armor_pierce="0" level="0" experience="0"/>
	</item>

	<item id="CK Gem of Power"
	      image="gameres/icons/items/Glowing Diamond.bmp"
	      sound="data/sound entities/ItemUse.xml"
	      level="0"
	      usecount="0"
	      name="CK Gem of Power"
	      description="The gem makes the Power of the Goddess flow through your veins"
	      cursed="1"
	      important="yes">
	  <bonus health="0" damage="160" armor_slash="0" armor_pierce="0" level="0" experience="0"/>
	</item>
  </add>
</patch>
